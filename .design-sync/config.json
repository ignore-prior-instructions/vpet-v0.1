{
  "pkg": "@vpet/ds",
  "globalName": "VpetDs",
  "shape": "package",
  "buildCmd": "npm --prefix packages/vpet-ds run build",
  "cssEntry": "dist/styles.css",
  "srcDir": "src/components",
  "runtimeFontPrefixes": [
    "Fredoka",
    "Nunito"
  ],
  "overrides": {
    "IconBar": {
      "cardMode": "column"
    },
    "PetSprite": {
      "cardMode": "column"
    },
    "Screen": {
      "cardMode": "column"
    },
    "Shell": {
      "cardMode": "column"
    },
    "Sprite": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
